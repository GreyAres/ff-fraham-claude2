---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Seite nicht gefunden">
  <section class="max-w-2xl mx-auto px-4 py-24 text-center">
    <p class="font-display text-feuerrot text-2xl mb-2">404</p>
    <h1 class="font-display text-4xl mb-4">Seite nicht gefunden</h1>
    <p class="text-graphit/70 mb-8">
      Die gesuchte Seite existiert nicht mehr oder wurde verschoben.
    </p>
    <a href="/" class="bg-feuerrot hover:bg-feuerrot-dark transition-colors text-white font-display text-lg px-6 py-3 rounded-sm">
      Zur Startseite
    </a>
  </section>
</BaseLayout>
