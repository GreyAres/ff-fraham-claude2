---
const navItems = [
  { href: '/', label: 'Startseite' },
  { href: '/einsaetze', label: 'Einsätze' },
  { href: '/fuhrpark', label: 'Fuhrpark' },
  { href: '/kontakt', label: 'Kontakt' },
];
const currentPath = Astro.url.pathname;
---
<header class="sticky top-0 z-50 bg-graphit text-white shadow-lg">
  <div class="h-1.5 w-full bg-gradient-to-r from-feuerrot via-feuerrot-light to-feuerrot"></div>
  <div class="max-w-6xl mx-auto px-4 flex items-center justify-between h-20">
    <a href="/" class="flex items-center gap-3 shrink-0">
      <img src="/images/logo-ff-fraham.svg" alt="Logo Freiwillige Feuerwehr Fraham" class="h-12 w-12" />
      <span class="font-display text-2xl md:text-3xl leading-none tracking-wide">
        FF&nbsp;<span class="text-feuerrot-light">Fraham</span>
      </span>
    </a>

    <nav class="hidden md:flex items-center gap-8 font-display text-lg tracking-wide" aria-label="Hauptnavigation">
      {navItems.map((item) => (
        <a
          href={item.href}
          class:list={[
            'relative py-2 hover:text-feuerrot-light transition-colors',
            currentPath === item.href && 'text-feuerrot-light after:content-[""] after:absolute after:left-0 after:right-0 after:-bottom-1 after:h-0.5 after:bg-feuerrot-light',
          ]}
        >
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href="tel:122"
        class="hidden sm:flex items-center gap-2 bg-feuerrot text-white font-display text-xl px-4 py-2 rounded-sm animate-pulse hover:animate-none hover:bg-feuerrot-dark transition-colors"
        aria-label="Notruf 122 anrufen"
      >
        <span class="block w-2.5 h-2.5 rounded-full bg-white"></span>
        Notruf 122
      </a>

      <button
        id="burger-toggle"
        class="md:hidden p-2"
        aria-label="Menü öffnen"
        aria-expanded="false"
        aria-controls="mobile-nav"
      >
        <svg width="28" height="28" viewBox="0 0 28 28" fill="none" xmlns="http://www.w3.org/2000/svg">
          <path d="M4 8h20M4 14h20M4 20h20" stroke="white" stroke-width="2" stroke-linecap="round"/>
        </svg>
      </button>
    </div>
  </div>

  <nav id="mobile-nav" class="md:hidden hidden border-t border-white/10 bg-graphit" aria-label="Mobile Navigation">
    <ul class="flex flex-col font-display text-lg">
      {navItems.map((item) => (
        <li>
          <a href={item.href} class="block px-4 py-3 border-b border-white/10 hover:bg-white/5">
            {item.label}
          </a>
        </li>
      ))}
      <li>
        <a href="tel:122" class="flex items-center gap-2 px-4 py-3 bg-feuerrot font-display text-lg">
          <span class="block w-2.5 h-2.5 rounded-full bg-white"></span>
          Notruf 122
        </a>
      </li>
    </ul>
  </nav>
</header>

<script>
  const toggle = document.getElementById('burger-toggle');
  const nav = document.getElementById('mobile-nav');
  toggle?.addEventListener('click', () => {
    const expanded = toggle.getAttribute('aria-expanded') === 'true';
    toggle.setAttribute('aria-expanded', String(!expanded));
    nav?.classList.toggle('hidden');
  });
</script>
